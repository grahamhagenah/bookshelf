// The database's address is in prisma.config.ts
datasource db {
  provider = "sqlite"
}

// Generated into the app, and kept out of git
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  firstname            String
  surname              String
  shareToken           String?    @unique
  // The public shelf's own address (bookstacks.app/@handle) and a line
  // about yourself at its top; both show only while sharing is on
  handle               String?    @unique
  bio                  String?
  // A personal link that makes whoever opens it your friend straight away
  friendInvite         String?    @unique
  isAdmin              Boolean    @default(false)
  // Superseded by theme; still read for accounts that haven't picked one
  darkMode             Boolean    @default(false)
  // "light", "dark" or "system" (follow the device)
  theme                String?
  // The library as "cover" grid or "list", and the grid's covers "large" or "small"
  libraryView          String     @default("cover")
  coverSize            String     @default("large")
  profileEmoji         String?
  // Two email switches: borrow requests, and the weekly roundup
  emailNotifications   Boolean    @default(true)
  weeklyDigest         Boolean    @default(true)
  // For admins only: new sign-ups by email "each" time, as one "daily"
  // summary, or "off"; and whether feedback is emailed as it comes in
  adminSignupEmails    String     @default("each")
  adminFeedbackEmails  Boolean    @default(true)
  // Whether other people can find them: in search and among new people.
  // Off, they're reached by invite link only.
  discoverable         Boolean    @default(true)
  // "free" or "plus". Plus lifts the book limit for everyone on the
  // shelf; set by a subscription, or by an admin as a gift
  plan                 String     @default("free")
  // The Stripe subscription behind Plus, kept in step by its webhook:
  // Stripe's status (active, past_due, canceled...), when the paid period
  // renews, and when it ends if they've cancelled
  stripeCustomerId     String?    @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  planRenewsAt         DateTime?
  planEndsAt           DateTime?
  // What they pay, for the dashboard's revenue: "month" or "year", the
  // amount per period in cents, and when the subscription began
  planInterval         String?
  planAmount           Int?
  planStartedAt        DateTime?
  // When they clicked the link we emailed; no digests or request emails
  // go out before then
  emailVerifiedAt      DateTime?
  // The last confirmation email, so the resend button can't be used to
  // flood an inbox
  verificationSentAt   DateTime?
  // The last password-reset email, so the form can't be used to flood an
  // inbox
  passwordResetSentAt  DateTime?
  // When someone lent them a book before they had an account: the account
  // waits, with no password and out of search, until they claim it from
  // the email. Cleared once they do.
  invitedAt            DateTime?
  // Someone lent a book by name only, with no email: a name in the
  // lender's records, not a person who can sign in or be emailed. Their
  // address is a stand-in at stacks.invalid, which never delivers.
  nameOnly             Boolean    @default(false)
  // Whose list of names a name-only person is on, to lend to in one tap
  // (a class, say). Taken off the list, they keep their loans.
  listedBy             User?      @relation("nameList", fields: [listedById], references: [id], onDelete: SetNull)
  listedById           String?
  // Set on throwaway demo accounts; everyone in one demo sandbox shares it
  demoGroup            String?
  // When a demo's visitor first went past the page they landed on: a person
  // looking around, rather than a bot that pressed the button
  demoExploredAt       DateTime?
  // People who share one shelf: each other's books count as their own
  household            Household? @relation(fields: [householdId], references: [id])
  householdId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  password Password?

  books          Book[]
  borrowedBooks  Book[]           @relation("borrowedBooks")
  lendingHistory LendingHistory[]
  readerNotes    ReaderNote[]
  holds          Hold[]
  wantToRead     WantToRead[]
  workNotes      WorkNote[]

  feedback              Feedback[]
  notificationsSent     Notification[] @relation("sender")
  notificationsReceived Notification[] @relation("receiver")

  followedBy User[]        @relation("UserFollows")
  following  User[]        @relation("UserFollows")
  pins       Pin[]
  // Friends you've kept out of your feed, and people who've kept you out
  // of theirs
  feedMutes  FeedMute[]    @relation("feedMutes")
  mutedBy    FeedMute[]    @relation("mutedBy")
  groups     GroupMember[]
  // The names on your list, lent to by name only
  nameList   User[]        @relation("nameList")

  @@index([demoGroup], name: "demo_group_index")
  @@index([listedById])
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Book {
  id               String    @id @default(cuid())
  cover            String
  title            String
  author           String
  body             String
  datePublished    String?
  pageCount        Int?
  subjects         String?
  publisher        String?
  openLibraryKey   String?
  isbn             String?
  lendCount        Int       @default(0)
  // When the owner read it; null means not yet
  readAt           DateTime?
  // Extra Open Library details, looked up once per book
  firstSentence    String?
  authorKey        String?
  detailsFetchedAt DateTime?
  // Kept off the owner's public page (and its numbers and preview), and
  // from group-mates who aren't friends; friends still see it on the shelf
  hiddenFromPage   Boolean   @default(false)
  // Not lending it until this moment: friends can't ask for it or wait
  // for it till then. Far in the future means until the owner says so.
  notLendingUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  borrower   User?     @relation("borrowedBooks", fields: [borrowerId], references: [id])
  borrowerId String?
  borrowedAt DateTime?
  dueDate    DateTime?

  notifications  Notification[]
  lendingHistory LendingHistory[]
  readerNotes    ReaderNote[]
  holds          Hold[]
  pins           Pin[]
}

// A book its owner has put at the top of their public page, in their
// order. What it says about the book is the owner's own reader note.
model Pin {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
}

model LendingHistory {
  id String @id @default(cuid())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId String

  borrower   User   @relation(fields: [borrowerId], references: [id])
  borrowerId String

  borrowedAt DateTime
  returnedAt DateTime?
  // When it was due at the time it came back, so an owner who says it
  // never did can put the loan back as it was
  dueDate    DateTime?

  // Taken off one side's History without touching the other's: the
  // lender's shelf, or the borrower
  hiddenByLender   Boolean @default(false)
  hiddenByBorrower Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([bookId], name: "lending_history_book_index")
  @@index([borrowerId], name: "lending_history_borrower_index")
}

model Notification {
  id   String @id @default(cuid())
  type String @default("FRIEND_REQUEST")

  sender   User @relation("sender", fields: [senderId], references: [id])
  receiver User @relation("receiver", fields: [receiverId], references: [id])

  senderName String

  senderId   String
  receiverId String

  book      Book?   @relation(fields: [bookId], references: [id])
  bookId    String?
  bookTitle String?
  // What an announcement from Stacks says, or the note a borrower sent
  // with their request; for someone joining a group, the group's name
  message   String?
  // The group someone joined, for a GROUP_JOINED notice
  groupId   String?

  read        Boolean  @default(false)
  actionTaken String?
  createdAt   DateTime @default(now())

  @@index([senderId], name: "sender_id_index")
  @@index([receiverId], name: "receiver_id_index")
}

// A reader's heart, optional short note, and whether they've read this
// copy. One per person per copy.
model ReaderNote {
  id     String    @id @default(cuid())
  loved  Boolean   @default(false)
  body   String?
  readAt DateTime?

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId])
  @@index([bookId], name: "reader_note_book_index")
}

// Open Library author details, shared by every copy of their books
// Open Library's answers, kept so a repeat question doesn't wait on it
// and a slow or down Open Library still has something to show. Keyed by
// the request's address; old ones are cleared out now and then.
model OpenLibraryResponse {
  url       String   @id
  body      String
  fetchedAt DateTime

  @@index([fetchedAt])
}

// Every book Stacks has come across: on a shelf, wanted, or in Open
// Library's search results. Suggestions come from here at once, while
// Open Library is asked.
model CatalogBook {
  // The Open Library work, /works/OL…W
  key       String   @id
  title     String
  author    String?
  coverId   Int?
  year      Int?
  pages     Int?
  subjects  String?
  publisher String?
  // How many editions Open Library lists: how widely read it is, which
  // ranks suggestions
  editions  Int?
  updatedAt DateTime @updatedAt
}

// A cover someone picked for a book by hand, shared with every other copy
// of it that still has Open Library's: by its ISBN ("isbn:…") and by its
// Open Library work ("/works/OL…W")
model SharedCover {
  key       String   @id
  cover     String
  // Who picked it, for when one needs undoing
  userId    String
  updatedAt DateTime @updatedAt
}

model Author {
  key       String   @id
  name      String
  bio       String?
  birthDate String?
  deathDate String?
  wikipedia String?
  updatedAt DateTime @updatedAt
}

// A friend waiting for a book that's out on loan. First come, first
// served: when the book comes back, the earliest hold becomes a request.
model Hold {
  id String @id @default(cuid())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([bookId, userId])
  @@index([bookId])
}

// A book someone wants to read but doesn't own. Stacks watches friends'
// shelves for it.
model WantToRead {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  title          String
  author         String
  cover          String
  openLibraryKey String?
  isbn           String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// A shared shelf. Everyone in it can see and manage each other's books;
// notes, hearts and friends stay their own.
model Household {
  id          String   @id @default(cuid())
  // Hand this out to let someone join; null once revoked
  inviteToken String?  @unique
  createdAt   DateTime @default(now())

  members User[]
}

// Something a person told us from the feedback page. Kept if their
// account goes; visitors who aren't signed in can leave an email to hear back.
model Feedback {
  id    String  @id @default(cuid())
  body  String
  // The page they were on when they opened the form
  page  String?
  // How to reach them, when they're not signed in
  email String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  // Ticked off on the admin dashboard
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A reader's heart, read mark and note on a book that isn't on their
// shelf: one they read somewhere else. Keyed by its Open Library work,
// with enough saved to show it when Open Library doesn't answer. The
// heart and note are for friends; the read mark is theirs alone.
model WorkNote {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  workKey String
  title   String
  author  String
  cover   String

  loved  Boolean   @default(false)
  body   String?
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workKey])
  @@index([workKey])
}

// People who lend to each other as a bunch: a book club, an office, a
// family. Being in one opens every member's shelf to every other, as
// friendship does, without anyone having to friend everyone.
model Group {
  id          String        @id @default(cuid())
  name        String
  // The link that lets anyone who has it join
  inviteToken String        @unique
  members     GroupMember[]
  // A few lines on what the group is, on its About tab and invite page
  description String?
  // Whether its page has the planning card (the book, the meetup, the
  // chat). A group that plans in its chat can turn it off; what's saved
  // stays for when it's turned back on
  planning    Boolean       @default(true)

  // What a group can choose to keep here, if it plans here rather than in
  // its chat, all optional and for any member to set. The book it's
  // reading: the Open Library work (or just the title, for a book without
  // one), with enough kept to show it, who picked it and when
  pickKey    String?
  pickTitle  String?
  pickAuthor String?
  pickCover  String?
  pickedById String?
  pickedAt   DateTime?
  // When and where it next meets
  meetsAt   DateTime?
  meetPlace String?
  // A link to its group chat (WhatsApp, Signal, Discord…), seen only by
  // members
  chatUrl String?
  // Who last changed any of it, and when
  boardById String?
  boardAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupMember {
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  joinedAt DateTime @default(now())
  // Which of the group's goings-on reach this member's alerts: a new pick,
  // a meetup set or moved, and someone joining
  alertPicks    Boolean @default(true)
  alertMeetups  Boolean @default(true)
  alertJoins    Boolean @default(true)

  @@id([groupId, userId])
  @@index([userId])
}

// A friend kept out of someone's feed: still a friend, still there to
// borrow from, just quiet in the feed, on the home page and in the
// weekly email
model FeedMute {
  user      User     @relation("feedMutes", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  muted     User     @relation("mutedBy", fields: [mutedId], references: [id], onDelete: Cascade)
  mutedId   String
  createdAt DateTime @default(now())

  @@id([userId, mutedId])
}
