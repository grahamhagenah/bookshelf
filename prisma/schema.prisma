datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String  @id @default(cuid())
  email              String  @unique
  firstname          String
  surname            String
  shareToken         String? @unique
  isAdmin            Boolean @default(false)
  darkMode           Boolean @default(false)
  profileEmoji       String?
  emailNotifications Boolean @default(true)
  // Set on throwaway demo accounts; everyone in one demo sandbox shares it
  demoGroup          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  password  Password?

  books     Book[]
  borrowedBooks Book[] @relation("borrowedBooks")
  lendingHistory LendingHistory[]
  readerNotes    ReaderNote[]
  holds          Hold[]

  notificationsSent     Notification[] @relation("sender")
  notificationsReceived Notification[] @relation("receiver")

  followedBy User[]  @relation("UserFollows")
  following  User[]  @relation("UserFollows")

  @@index([demoGroup], name: "demo_group_index")
}

model Password {
  hash   String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Book {
  id            String  @id @default(cuid())
  cover         String
  title         String
  author        String
  body          String
  datePublished String?
  pageCount     Int?
  subjects      String?
  publisher     String?
  openLibraryKey String?
  lendCount     Int     @default(0)
  // Extra Open Library details, looked up once per book
  firstSentence  String?
  authorKey      String?
  detailsFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  borrower   User?   @relation("borrowedBooks", fields: [borrowerId], references: [id])
  borrowerId String?
  borrowedAt DateTime?
  dueDate    DateTime?

  notifications Notification[]
  lendingHistory LendingHistory[]
  readerNotes    ReaderNote[]
  holds          Hold[]
}

model LendingHistory {
  id         String   @id @default(cuid())

  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String

  borrower   User     @relation(fields: [borrowerId], references: [id])
  borrowerId String

  borrowedAt DateTime
  returnedAt DateTime?

  createdAt  DateTime @default(now())

  @@index([bookId], name: "lending_history_book_index")
  @@index([borrowerId], name: "lending_history_borrower_index")
}

model Notification {
  id        String @id @default(cuid())
  type      String @default("FRIEND_REQUEST")

  sender     User     @relation("sender", fields: [senderId], references: [id])
  receiver   User     @relation("receiver", fields: [receiverId], references: [id])

  senderName String

  senderId   String
  receiverId String

  book       Book?   @relation(fields: [bookId], references: [id])
  bookId     String?
  bookTitle  String?

  read        Boolean  @default(false)
  actionTaken String?
  createdAt   DateTime @default(now())

  @@index([senderId], name: "sender_id_index")
  @@index([receiverId], name: "receiver_id_index")
}

// A reader's heart and optional short note on one copy of a book
model ReaderNote {
  id     String  @id @default(cuid())
  loved  Boolean @default(false)
  body   String?

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId])
  @@index([bookId], name: "reader_note_book_index")
}

// Open Library author details, shared by every copy of their books
model Author {
  key       String   @id
  name      String
  bio       String?
  birthDate String?
  deathDate String?
  wikipedia String?
  updatedAt DateTime @updatedAt
}

// A friend waiting for a book that's out on loan. First come, first
// served: when the book comes back, the earliest hold becomes a request.
model Hold {
  id String @id @default(cuid())

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())

  @@unique([bookId, userId])
  @@index([bookId])
}
